# RIYAI Platform Environment Configuration
# Copy this file to .env.local for local development.
# IMPORTANT: NEVER commit real API keys or secrets to version control.

# Application
NEXT_PUBLIC_APP_NAME=RIYAI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Primary AI Model Provider: Google Gemini (Server-side ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Storage (for user file uploads and knowledge attachments)
STORAGE_BUCKET_NAME=riyai-attachments
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
